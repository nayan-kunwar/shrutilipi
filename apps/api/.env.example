# Copy to .env for local dev (optional — or export directly).
# Uvicorn does not read this file by default; if you use it, run:
#   python -m uvicorn main:app --reload --env-file .env
# Windows (PowerShell): $env:FRONTEND_URL="http://localhost:3000"
FRONTEND_URL=http://localhost:3000
PORT=8000

# FRONTEND_URL = comma-separated list of allowed frontend origins.
#   FRONTEND_URL=https://shrutilipi.nayankunwar.com,https://shrutilipi-rho.vercel.app
# The production origins are ALSO hardcoded in apps/api/main.py (PROD_ORIGINS),
# so this var can only *add* origins — a stale or wrong value here can no
# longer lock the production frontend out of its own API. Localhost on any
# port is allowed separately via allow_origin_regex.

# Provider chain (local default = direct only; Render sets DIRECT_ENABLED=false)
# CHAIN_ORDER=direct,supadata,serpapi
# DIRECT_ENABLED=true
# SUPADATA_API_KEY=
# SUPADATA_ENABLED=true
# SERPAPI_API_KEY=
# SERPAPI_ENABLED=false
# SERPAPI_TIME_UNIT=auto

# Optional on-demand AI summary. OFF unless ALL THREE of BASE_URL, API_KEY and
# MODEL are set; a missing one returns 503 summary_disabled while transcripts
# keep working. Any OpenAI-compatible chat endpoint works — the client sends
# only {videoId, lang}, never transcript text. Limits/cost: operations.md §9.
# Gemini Flash (recommended free-tier default):
# SUMMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SUMMARY_MODEL=gemini-2.5-flash
# Groq (alternative):
# SUMMARY_BASE_URL=https://api.groq.com/openai/v1
# SUMMARY_MODEL=llama-3.3-70b-versatile
# SUMMARY_API_KEY=
# Optional tuning (defaults shown):
# SUMMARY_TIMEOUT_SECONDS=30
# SUMMARY_MAX_CHARS=15000
# SUMMARY_MAX_OUTPUT_TOKENS=350
# SUMMARY_RATE_LIMIT_REQUESTS=5
# SUMMARY_RATE_LIMIT_WINDOW_SECONDS=600

# Webshare free-tier proxy (leave unset for direct/local — no proxy)
# Option A: full URLs (scheme://user:pass@host:port), comma-separated
# WEBSHARE_PROXY_LIST=http://user:pass@host1:port,http://user:pass@host2:port
# Option B: single user/pass + 10 host:port endpoints (rotation picks one per request)
# WEBSHARE_PROXY_USERNAME=your_user
# WEBSHARE_PROXY_PASSWORD=your_pass
# WEBSHARE_PROXY_HOSTS=host1:port,host2:port,host3:port
