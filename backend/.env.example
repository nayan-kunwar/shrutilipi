# Copy to .env for local dev (optional — or export directly)
# Windows (PowerShell): $env:FRONTEND_URL="http://localhost:3000"
FRONTEND_URL=http://localhost:3000
PORT=8000

# Webshare free-tier proxy (leave unset for direct/local — no proxy)
# Option A: full URLs (scheme://user:pass@host:port), comma-separated
# WEBSHARE_PROXY_LIST=http://user:pass@host1:port,http://user:pass@host2:port
# Option B: single user/pass + 10 host:port endpoints (rotation picks one per request)
# WEBSHARE_PROXY_USERNAME=your_user
# WEBSHARE_PROXY_PASSWORD=your_pass
# WEBSHARE_PROXY_HOSTS=host1:port,host2:port,host3:port
